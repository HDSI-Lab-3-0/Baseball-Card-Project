---
import Layout from '../layouts/Layout.astro';
import CardBuilder from '../components/CardBuilder';
import PiCardDisplay from '../components/PiCardDisplay';
---

<Layout title="Baseball Card Generator">
  <header class="bg-gray-800 border-b border-gray-700 py-4 px-8">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-2xl font-bold text-white flex items-center gap-3">
        <span class="text-3xl"></span>
        Baseball Card Generator
      </h1>
    </div>
  </header>

  <CardBuilder client:load />

  <div class="border-t border-gray-700 mt-8 pt-8 px-8">
    <h2 class="text-xl font-bold text-white text-center mb-6">⚡ Live from Pi</h2>
    <PiCardDisplay client:load />
  </div>
</Layout>