---
// src/pages/kiosk.astro
import KioskFlow from '../components/KioskFlow';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Baseball Card Generator</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; height: 100%; overflow: hidden; background: #030712; }
      /* Disable text selection on touch */
      body { user-select: none; -webkit-user-select: none; }
    </style>
  </head>
  <body>
    <KioskFlow client:load />
  </body>
</html>