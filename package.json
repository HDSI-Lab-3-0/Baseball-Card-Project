{
  "name": "baseball-cards",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "kiosk:install": "python3 -m venv photobooth-kiosk/.venv && photobooth-kiosk/.venv/bin/pip install -r photobooth-kiosk/requirements.txt",
    "kiosk": "photobooth-kiosk/.venv/bin/python photobooth-kiosk/main.py",
    "kiosk:fullscreen": "photobooth-kiosk/.venv/bin/python photobooth-kiosk/main.py --fullscreen",
    "kiosk:dev": "KIOSK_DEV=1 photobooth-kiosk/.venv/bin/python photobooth-kiosk/main.py",
    "kiosk:build": "cd photobooth-kiosk && .venv/bin/pip install -q pyinstaller && .venv/bin/pyinstaller build/photobooth.spec"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
